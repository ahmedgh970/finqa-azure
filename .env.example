# Configuration locale. Copier dans .env ; ne jamais versionner .env.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=granite4.1:3b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Identifiants de configuration, pas des secrets. Copier depuis az account show.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Choix explicite de la session CLI dans la chaîne DefaultAzureCredential.
AZURE_TOKEN_CREDENTIALS=AzureCliCredential
AZURE_REQUEST_TIMEOUT_SECONDS=10

# Facultatif. Copier l'endpoint du projet Foundry existant, pas celui du modèle.
# https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Endpoint Blob : https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_NAME=financial-pdfs

# Endpoint Search : https://<search-service>.search.windows.net
AZURE_SEARCH_SERVICE_ENDPOINT=

# Endpoint de la ressource Azure OpenAI existante, sans /openai/v1.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Déploiement du modèle de génération RAG.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.2

# Juge d'évaluation (doit être distinct du déploiement de génération).
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-5-mini

# Configuration sémantique de l'index (mode semantic_hybrid).
AZURE_SEARCH_SEMANTIC_CONFIGURATION=finance-semantic
